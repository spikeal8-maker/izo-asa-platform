        "type": "object"
      },
      "SessionView": {
        "properties": {
          "client_label": {
            "title": "Client Label",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "integer"
          },
          "current": {
            "title": "Current",
            "type": "boolean"
          },
          "expires_at": {
            "title": "Expires At",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "last_seen_at": {
            "title": "Last Seen At",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "created_at",
          "last_seen_at",
          "expires_at",
          "client_label",
          "current"
        ],
        "title": "SessionView",
        "type": "object"
      }
    }
