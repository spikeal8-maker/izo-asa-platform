          "stage",
          "build_sha",
          "capabilities"
        ],
        "title": "FoundationStatus",
        "type": "object"
      },
      "LoginInput": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginInput",
        "type": "object"
      },
      "Modality": {
        "enum": [
          "image",
          "video",
          "audio",
          "3d",
          "chat"
        ],
        "title": "Modality",
        "type": "string"
      },
      "RegisterInput": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "invite_code": {
            "format": "password",
            "maxLength": 43,
            "minLength": 43,
            "title": "Invite Code",
            "type": "string",
            "writeOnly": true
          },
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 15,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password",
          "display_name",
          "invite_code"
        ],
        "title": "RegisterInput",
        "type": "object"
      },
