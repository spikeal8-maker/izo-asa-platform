            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": [
          "account",
          "csrf_token"
        ],
        "title": "AuthView",
        "type": "object"
      },
      "CapabilityStatus": {
        "properties": {
          "available": {
            "title": "Available",
