{
  "components": {
    "schemas": {
      "AccountView": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "email_verified": {
            "title": "Email Verified",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "title": "Permissions",
            "type": "array"
          },
          "public_code": {
            "title": "Public Code",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "id",
          "public_code",
          "display_name",
          "email",
          "email_verified",
          "state",
          "permissions"
        ],
        "title": "AccountView",
        "type": "object"
      },
      "AuthErrorView": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "AuthErrorView",
        "type": "object"
      },
      "AuthView": {
        "properties": {
          "account": {
            "$ref": "#/components/schemas/AccountView"
